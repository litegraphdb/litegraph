        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "DS_LOKI"
          },
          "editorMode": "code",
          "expr": "{service=~\"litegraph.*\", component=~\"$component\", severity=~\"error|critical\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors And Critical Only",
      "type": "logs"
    }
  ],
