# Copy to .env (gitignored) and adjust.  Every variable is optional; defaults are shown.

# LiteGraph image tag.  Use the tag you built with build-all.bat to run a local build.
LITEGRAPH_IMAGE_TAG=v10.0.0

# Host ports
LITEGRAPH_REST_HOST_PORT=8701
LITEGRAPH_MCP_HOST_PORT=8702
LITEGRAPH_MCP_TCP_HOST_PORT=8703
LITEGRAPH_MCP_WS_HOST_PORT=8704
LITEGRAPH_MCP_METRICS_HOST_PORT=8705
LITEGRAPH_UI_HOST_PORT=3001
LITEGRAPH_GRAFANA_HOST_PORT=3000
LITEGRAPH_PROMETHEUS_HOST_PORT=9090
LITEGRAPH_LOKI_HOST_PORT=3100
LITEGRAPH_ALLOY_HOST_PORT=12345
