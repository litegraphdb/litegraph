#
#
# LiteGraph MCP Server as a Native AOT executable (no .NET runtime in the image).
# Same settings, environment variables, ports, and behavior as the JIT image built from Dockerfile.
#
# Run the docker build command from the repository root, not from src or the project directory:
#   docker build -f src/LiteGraph.McpServer/Dockerfile.native -t jchristn77/litegraph-mcp:<tag>-native .
# Multi-architecture builds work with buildx (--platform linux/amd64,linux/arm64/v8); each architecture is compiled
# natively for its platform.
#
#


#
#
# Build stage: Native AOT needs clang and zlib on the build machine.
#
#
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
RUN apt-get update && apt-get install -y clang zlib1g-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY src ./src
COPY sdk/csharp ./sdk/csharp
COPY README.md ./README.md
WORKDIR /repo/src/LiteGraph.McpServer
RUN RID=$([ "$TARGETARCH" = "arm64" ] && echo linux-arm64 || echo linux-x64) \
    && dotnet publish LiteGraph.McpServer.csproj -c Release -f net10.0 -r "$RID" -p:PublishAot=true -p:GeneratePackageOnBuild=false -p:ErrorOnDuplicatePublishOutputFiles=false -o /app/publish \
    && rm -f /app/publish/*.pdb /app/publish/*.dbg


#
#
# Runtime stage: runtime-deps carries only the native libraries a .NET executable needs (ICU, OpenSSL).
#
#
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS final
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8702 8703 8704
ENTRYPOINT ["./LiteGraph.McpServer"]
